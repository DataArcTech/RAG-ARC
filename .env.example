# ============================================
# LLM API Configuration
# ============================================
# Setup your LLM API config
# For OpenAI: https://platform.openai.com/docs/api-reference
# For DeepSeek: https://api-docs.deepseek.com/
# For other providers: check their documentation

OPENAI_API_KEY=sk-xxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1

# Choose device to run AI models (cpu, cuda:0, cuda:1 etc.)
DEVICE=xxx

# Embedding model config, Qwen/Qwen3-Embedding-0.6B or BAAI/bge-large-zh-v1.5
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B

# If you use Azure OpenAI, uncomment below and fill in your info
# API_VERSION=2025-01-01-preview
# OPENAI_PROVIDER=azure

# ============================================
# PostgreSQL Database Configuration
# ============================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5555
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123
POSTGRES_DB=rag_arc

# ============================================
# Redis Cache Configuration
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# Optional host port for Docker exposure (used when DEVELOP_MODE/EXPOSE_REDIS=true)
REDIS_HOST_PORT=6379
EXPOSE_REDIS=false

# ============================================
# Celery / Long-Task Queue (Celery + Redis)
# ============================================
# Switch between in-process background tasks (default) and Celery workers.
TASK_QUEUE_MODE=inprocess  # inprocess|celery
# Celery broker/result backend (defaults to redis://REDIS_HOST:REDIS_PORT/REDIS_DB when empty)
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
# Queue routing (API send_task queue names)
CELERY_QUEUE_INDEXING=indexing
CELERY_QUEUE_DEEPSEARCH=deepsearch
# Optional queue for export tasks (graph/mindmap). Defaults to CELERY_QUEUE_INDEXING when empty.
CELERY_QUEUE_EXPORT=
# Task acknowledgements / prefetch
CELERY_TASK_IGNORE_RESULT=true
CELERY_RESULT_EXPIRES_SECONDS=3600
CELERY_TASK_ACKS_LATE=true
CELERY_ACKS_ON_FAILURE_OR_TIMEOUT=true
CELERY_REJECT_ON_WORKER_LOST=true
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=0
CELERY_TASK_TIME_LIMIT_SECONDS=0
CELERY_VISIBILITY_TIMEOUT_SECONDS=86400
# TaskRun / Progress / Result retention (seconds)
MQ_NAMESPACE=rag-arc:mq
MQ_TASK_RUN_TTL_SECONDS=86400
MQ_PROGRESS_TTL_SECONDS=86400
MQ_RESULT_TTL_SECONDS=86400
MQ_STREAM_MAXLEN=20000
# When Redis is unavailable:
# - inprocess mode: best-effort no-op (API can still run)
# - celery mode: fail-fast by default to avoid "tasks running but status/progress missing"
MQ_FAILFAST_ON_REDIS_DOWN=
# Simple distributed lock for file operations (index/delete) (seconds)
FILE_OP_LOCK_TTL_SECONDS=21600
# Deprecated: replaced by FILE_OP_LOCK_TTL_SECONDS (kept for reference only)
# INDEXING_LOCK_TTL_SECONDS=21600
# DELETION_LOCK_TTL_SECONDS=21600
# Retry policy (Celery task exceptions)
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_RETRY_COUNTDOWN_SECONDS=5
# Retry policy when file lock is busy (avoid concurrent index/delete on same file_id)
CELERY_TASK_LOCK_MAX_RETRIES=30
CELERY_TASK_LOCK_RETRY_COUNTDOWN_SECONDS=2

# ============================================
# DeepSearch on Graph Defaults
# ============================================
# Default Graph Adapter registered in the GraphAdapter registry
DEEPSEARCH_DEFAULT_ADAPTER=hipporag
# Planner runtime mode (react / iter_research / parallel_thinking)
DEEPSEARCH_PLANNER_MODE=react
# GraphReasoning strategy label (e.g., ppr_chain / semantic_chain)
DEEPSEARCH_GRAPH_STRATEGY=ppr_chain
# Planner limits and switches
DEEPSEARCH_PLANNER_MAX_STEPS=6
DEEPSEARCH_PLANNER_ENABLE_SUBQUESTION=true
# Planner LLM overrides (leave blank to reuse global chat defaults)
DEEPSEARCH_PLANNER_DISABLE_LLM=false
DEEPSEARCH_PLANNER_LLM_PROVIDER=
DEEPSEARCH_PLANNER_MODEL_NAME=
DEEPSEARCH_PLANNER_MAX_TOKENS=
DEEPSEARCH_PLANNER_TEMPERATURE=
DEEPSEARCH_PLANNER_API_KEY=
DEEPSEARCH_PLANNER_BASE_URL=
DEEPSEARCH_PLANNER_ORGANIZATION=
DEEPSEARCH_PLANNER_TIMEOUT=
DEEPSEARCH_PLANNER_MAX_RETRIES=
# Planner persistence + external gating (config is SoT; env can override enablement)
DEEPSEARCH_PERSIST_PLAN=true
DEEPSEARCH_PLAN_OUTPUT_DIR=./local/deepsearch_runs
# Tool execution artifacts/telemetry directory (relative to project root).
DEEPSEARCH_TOOL_ARTIFACT_DIR=./local/deepsearch_artifacts
DEEPSEARCH_ALLOW_EXTERNAL_CHANNEL=false
DEEPSEARCH_EXTERNAL_SEARCH_ENABLED=false
DEEPSEARCH_TELEMETRY_ENABLED=true
TAVILY_API_KEY=
# External search routing hint: tavily / tool / mcp (leave empty to default to tavily)
DEEPSEARCH_WEB_PROVIDER=
# Optional JSON list to override tool hints shown to planner
DEEPSEARCH_TOOL_HINTS=
# MCP tool server adapter overrides (optional JSON payloads)
DEEPSEARCH_TOOL_MCP_CONFIG_PATH=
DEEPSEARCH_TOOL_MCP_ADAPTER_CONFIG=
DEEPSEARCH_TOOL_MCP_ADAPTER_NAME=
DEEPSEARCH_TOOL_MCP_ADAPTER_PARAMS={}
DEEPSEARCH_TOOL_MCP_SCOPE_ID=
DEEPSEARCH_TOOL_MCP_SCOPE_TYPE=owner
DEEPSEARCH_TOOL_MCP_SCOPE_LABELS=[]
DEEPSEARCH_TOOL_MCP_SCOPE_ATTRIBUTES={}
DEEPSEARCH_TOOL_MCP_TOOLS=
# Traversal knobs
DEEPSEARCH_ALLOW_SEMANTIC_CHANNEL=true
DEEPSEARCH_CHAIN_DEPTH=4
# Finance-specific hooks (enable only when specialized logic is ready)
DEEPSEARCH_ENABLE_FINANCE_HOOKS=false
# MCP Tool channel (leave empty to disable MCP)
DEEPSEARCH_MCP_SERVER_URI=
DEEPSEARCH_MCP_API_KEY=
DEEPSEARCH_MCP_TRANSPORT=auto  # auto/sse/stdio
DEEPSEARCH_MCP_STDIO_COMMAND=  # e.g. python path/to/server.py
DEEPSEARCH_MCP_STDIO_ENV={}  # JSON dict, e.g. {"PYTHONPATH": "./tools"}
DEEPSEARCH_MCP_HEADERS={}  # JSON dict for extra HTTP headers
DEEPSEARCH_MCP_TIMEOUT=30
DEEPSEARCH_MCP_READ_TIMEOUT=300
DEEPSEARCH_MCP_PERSISTENT_SESSION=true
DEEPSEARCH_MCP_ENABLE_GRAPH_CONTEXT=true
DEEPSEARCH_MCP_GRAPH_CONTEXT_FIELD=__graph_context__
# Gap detection thresholds
DEEPSEARCH_GAP_COVERAGE_THRESHOLD=0.7
DEEPSEARCH_GAP_CONFIDENCE_THRESHOLD=0.6
DEEPSEARCH_GAP_EXPECTED_MIN_CHUNKS=3
# Report generation: enable LLM-based consistency check (validates claims against evidence)
DEEPSEARCH_CONSISTENCY_CHECK=true
# Report generation: generate report sections in parallel (faster but uses more API calls)
DEEPSEARCH_PARALLEL_SECTIONS=false

# ============================================
# DeepSearch Quality Loop (research → quality gate → iterate)
# ============================================
# Enable iterative quality gating (citations/consistency based + optional LLM judge).
DEEPSEARCH_QUALITY_LOOP_ENABLED=false
# Maximum rounds (initial + follow-ups).
DEEPSEARCH_QUALITY_LOOP_MAX_ROUNDS=2
# Minimum fraction of report sentences that include valid citations.
DEEPSEARCH_QUALITY_LOOP_MIN_CITATION_SENTENCE_COVERAGE=0.6
# Fail the gate when the consistency checker reports issues.
DEEPSEARCH_QUALITY_LOOP_REQUIRE_CONSISTENCY=true
# Maximum uncited sentences surfaced as repair targets.
DEEPSEARCH_QUALITY_LOOP_MAX_UNCITED_SENTENCES=6
# Maximum follow-up actions produced by the gate.
DEEPSEARCH_QUALITY_LOOP_MAX_ACTIONS=6
# Enable LLM rubric judge (called only when deterministic checks fail or gaps exist).
DEEPSEARCH_QUALITY_LOOP_ENABLE_LLM_JUDGE=true
DEEPSEARCH_QUALITY_LOOP_JUDGE_TEMPERATURE=0.0
DEEPSEARCH_QUALITY_LOOP_JUDGE_MAX_RETRIES=1
# Allow the gate to request external search when enabled.
DEEPSEARCH_QUALITY_LOOP_TRIGGER_EXTERNAL_ON_FAILURE=true

# ============================================
# Application Configuration
# ============================================
# JWT Secret Key - Run: openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-change-this-in-production

# HuggingFace Token (optional, for downloading models)
HF_TOKEN=

# Log Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ============================================
# File Storage Configuration
# ============================================
# Unified parser output directory (all parsers output to subdirectories here)
# Structure: {PARSER_OUTPUT_DIR}/native/, {PARSER_OUTPUT_DIR}/dots_ocr/, {PARSER_OUTPUT_DIR}/vlm_ocr/
PARSER_OUTPUT_DIR=./data/parsed_files

# Local file storage path
LOCAL_FILE_STORAGE_PATH=./local/files

# ============================================
# Neo4j Graph Database Configuration
# ============================================
# Neo4j connection (auto-configured by Docker deployment)
NEO4J_URL=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=12345678
NEO4J_DATABASE=neo4j

# Docker: Expose Neo4j ports to host (default: false for security)
# Set to true if you want to access Neo4j Browser at http://localhost:7474
EXPOSE_NEO4J=false

# Docker: Neo4j port mapping (only used if EXPOSE_NEO4J=true)
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ============================================
# Optional: MinIO Object Storage
# ============================================
# Uncomment if you want to use MinIO
# MINIO_ENDPOINT=localhost:9000
# MINIO_USERNAME=ROOTNAME
# MINIO_PASSWORD=CHANGEME123
# MINIO_BUCKET=rag-arc-bucket
# MINIO_SECURE=false

# ============================================
# Integration / Test Flags (optional)
# ============================================
# Set to 1 (or any non-empty value) to opt-in when the required services/models are available.
# Leave empty to skip those suites.
RUN_RAGARC_INTEGRATION_TESTS=
RUN_RAGARC_POSTGRES_TESTS=
RUN_RAGARC_CHAT_STORAGE_TESTS=
RUN_RAGARC_VECTOR_TESTS=
# Opt-in: run real-Redis message-queue stress smoke tests (pytest)
RUN_RAGARC_MQ_STRESS_TESTS=
# Token used by test/test_complete_e2e_api.py to authenticate API requests
RAGARC_E2E_TOKEN=
