# ============================================
# LLM API Configuration
# ============================================
# Setup your LLM API config
# For OpenAI: https://platform.openai.com/docs/api-reference
# For DeepSeek / other OpenAI-compatible providers: point to their OpenAI-format relay

# Chat provider (openai = OpenAI-compatible API, huggingface = local HF model)
CHAT_MODEL_PROVIDER=openai
# Optional override used by the config layer (preferred over OPENAI_CHAT_MODEL when set)
CHAT_MODEL_NAME=
# HuggingFace chat model runtime options (used when CHAT_MODEL_PROVIDER=huggingface)
CHAT_MODEL_DEVICE=cpu
CHAT_MODEL_CACHE_FOLDER=
CHAT_API_KEY=  # e.g. sk-xxxxx when using openai provider
CHAT_API_BASE_URL=  # e.g. https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini  # e.g. gpt-4o-mini (API) or Qwen/Qwen2.5-7B (local)
# Optional legacy alias used by some utilities
OPENAI_API_BASE=

# Embedding provider (openai = OpenAI-compatible API, huggingface = local HF model)
EMBEDDING_MODEL_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_API_BASE_URL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small  # e.g. text-embedding-3-large (API) or Qwen/Qwen3-Embedding-0.6B (local)
# HuggingFace embedding runtime options (used when EMBEDDING_MODEL_PROVIDER=huggingface)
EMBEDDING_DEVICE=cpu
EMBEDDING_CACHE_FOLDER=

# OCR provider (openai = GPT-4o style API, vllm = self-hosted VLM/dots_ocr)
OCR_MODEL_PROVIDER=openai
OCR_API_KEY=
OCR_API_BASE_URL=
OPENAI_OCR_MODEL=gpt-4o-mini  # e.g. gpt-4o, gpt-4o-mini or local VLM name (dots_ocr uses ./models/dots_ocr)
DOTS_OCR_CACHE_FOLDER=./models/dots_ocr

# Reranker (local HuggingFace Qwen, used when MODEL_PROFILE=local)
# Running in API mode? Leave these as-is and the listwise reranker will use CHAT provider.
RERANKER_MODEL_NAME=Qwen/Qwen3-Reranker-0.6B
RERANKER_CACHE_FOLDER=./models/Qwen
RERANKER_DEVICE=cpu

# Optional shared defaults used when the component-specific values are empty
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Choose device to run AI models (cpu, cuda:0, cuda:1 etc.)
DEVICE=cpu

# Embedding model config for local HuggingFace models (qwen, bge, etc.)
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B

# Optional: override default config files when customizing modules
# RAG_INFERENCE_CONFIG_PATH=config/json_configs/rag_inference.json
# KNOWLEDGE_CONFIG_PATH=config/json_configs/knowledge.json

# Optional: choose built-in config profile (api/local)
MODEL_PROFILE=api  # api -> config/json_configs/rag_inference.json, local -> *_local.json

# ============================================
# Evidence Output Controls
# ============================================
ENABLE_ALL_EVIDENCE=false
CHAT_TOP_CHUNKS=5
CHAT_TOP_TRIPLES=5
CHAT_TOP_SEED_ENTITIES=5
DEEPSEARCH_TOP_CHUNKS=10
DEEPSEARCH_TOP_TRIPLES=30
DEEPSEARCH_TOP_SEED_ENTITIES=15
DEEPSEARCH_GRAPH_NODE_LIMIT=75
DEEPSEARCH_GRAPH_EDGE_LIMIT=200
DEEPSEARCH_MAX_REASONING_STEPS=32
DEEPSEARCH_MAX_STAGE_HISTORY=10
DEEPSEARCH_MAX_EXTERNAL_CALLS=5
DEEPSEARCH_MAX_TOOL_METADATA=5

# ============================================
# Chatbot (SSE v2)
# ============================================
# Shared document library owner (all users share this corpus; manage it via `rag-arc ingest-folder --owner-id ...`)
CHATBOT_SHARED_DOCUMENT_OWNER_ID=00000000-0000-0000-0000-000000000001
# Concurrency: total in-flight chatbot requests (across users/conversations)
CHATBOT_MAX_CONCURRENCY=8
# Context window: last N turns (N*2 messages) from client-provided history
CHATBOT_CONTEXT_TURNS=5
# Context length guardrails (heuristic token estimation)
CHATBOT_MAX_CONTEXT_TOKENS=8192
CHATBOT_MAX_CONTEXT_FRACTION=0.9
# Evidence payload limits
CHATBOT_TOP_SOURCES=5
CHATBOT_SOURCE_MAX_CHARS=1600
# Conversation ordering + resource control
CHATBOT_CONVERSATION_LOCK_TIMEOUT_S=30
CHATBOT_GLOBAL_SEMAPHORE_TIMEOUT_S=30
CHATBOT_LOCK_TTL_S=1800
# Cookie controls (rag_arc_uid)
CHATBOT_COOKIE_HTTPONLY=0
# Optional: override chatbot module configs (defaults to the global modules when empty)
CHATBOT_RAG_INFERENCE_CONFIG_PATH=
CHATBOT_KNOWLEDGE_CONFIG_PATH=

# Development mode: set to true to expose all Docker services to localhost
DEVELOP_MODE=false
# When DEVELOP_MODE=true the CLI will default to this owner ID (must be a valid UUID string)
DEVELOP_OWNER_ID=00000000-0000-0000-0000-000000000001
DEVELOP_OWNER_USERNAME=dev_cli_user
DEVELOP_OWNER_PASSWORD=dev-cli-password
# Optional admin UUID allowed to view all data (leave empty to disable)
ADMIN_OWNER_ID=00000000-0000-0000-0000-00000000ABCD

# If you use Azure OpenAI, uncomment below and fill in your info
# API_VERSION=2025-01-01-preview
# OPENAI_PROVIDER=azure

# ============================================
# PostgreSQL Database Configuration
# ============================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5555
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123
POSTGRES_DB=rag_arc
# Optional: expose PostgreSQL container port to host (used when DEVELOP_MODE/EXPOSE_POSTGRES=true)
POSTGRES_HOST_PORT=5555
EXPOSE_POSTGRES=false

# ============================================
# Redis Cache Configuration
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# Optional host port for Docker exposure (used when DEVELOP_MODE/EXPOSE_REDIS=true)
REDIS_HOST_PORT=6379
EXPOSE_REDIS=false

# ============================================
# DeepSearch on Graph Defaults
# ============================================
# Default Graph Adapter registered in the GraphAdapter registry
DEEPSEARCH_DEFAULT_ADAPTER=hipporag
# Planner runtime mode (react / iter_research / parallel_thinking)
DEEPSEARCH_PLANNER_MODE=react
# GraphReasoning strategy label (e.g., ppr_chain / semantic_chain)
DEEPSEARCH_GRAPH_STRATEGY=ppr_chain
# Planner limits and switches
DEEPSEARCH_PLANNER_MAX_STEPS=6
DEEPSEARCH_PLANNER_ENABLE_SUBQUESTION=true
# Planner LLM overrides (leave blank to reuse global chat defaults)
DEEPSEARCH_PLANNER_DISABLE_LLM=false
DEEPSEARCH_PLANNER_LLM_PROVIDER=
DEEPSEARCH_PLANNER_MODEL_NAME=
DEEPSEARCH_PLANNER_MAX_TOKENS=
DEEPSEARCH_PLANNER_TEMPERATURE=
DEEPSEARCH_PLANNER_API_KEY=
DEEPSEARCH_PLANNER_BASE_URL=
DEEPSEARCH_PLANNER_ORGANIZATION=
DEEPSEARCH_PLANNER_TIMEOUT=
DEEPSEARCH_PLANNER_MAX_RETRIES=
# Planner persistence + external gating
DEEPSEARCH_PERSIST_PLAN=true
DEEPSEARCH_PLAN_OUTPUT_DIR=./local/deepsearch_runs
# Tool execution artifacts/telemetry directory (relative to project root).
DEEPSEARCH_TOOL_ARTIFACT_DIR=./local/deepsearch_artifacts
DEEPSEARCH_ALLOW_EXTERNAL_CHANNEL=false
DEEPSEARCH_EXTERNAL_SEARCH_ENABLED=false
DEEPSEARCH_TELEMETRY_ENABLED=true
TAVILY_API_KEY=
# Default MCP provider for web search channel (leave empty to auto-select)
DEEPSEARCH_WEB_PROVIDER=
# Optional JSON list to override tool hints shown to planner
DEEPSEARCH_TOOL_HINTS=
# MCP tool server adapter overrides (optional JSON payloads)
DEEPSEARCH_TOOL_MCP_CONFIG_PATH=
DEEPSEARCH_TOOL_MCP_ADAPTER_CONFIG=
DEEPSEARCH_TOOL_MCP_ADAPTER_NAME=
DEEPSEARCH_TOOL_MCP_ADAPTER_PARAMS={}
DEEPSEARCH_TOOL_MCP_SCOPE_ID=
DEEPSEARCH_TOOL_MCP_SCOPE_TYPE=owner
DEEPSEARCH_TOOL_MCP_SCOPE_LABELS=[]
DEEPSEARCH_TOOL_MCP_SCOPE_ATTRIBUTES={}
DEEPSEARCH_TOOL_MCP_TOOLS=
# Traversal knobs
DEEPSEARCH_ALLOW_SEMANTIC_CHANNEL=true
DEEPSEARCH_CHAIN_DEPTH=4
# Finance-specific hooks (enable only when specialized logic is ready)
DEEPSEARCH_ENABLE_FINANCE_HOOKS=false
# MCP Tool channel (leave empty to disable MCP)
DEEPSEARCH_MCP_SERVER_URI=
DEEPSEARCH_MCP_API_KEY=
DEEPSEARCH_MCP_TRANSPORT=auto  # auto/sse/stdio
DEEPSEARCH_MCP_STDIO_COMMAND=  # e.g. python path/to/server.py
DEEPSEARCH_MCP_STDIO_ENV={}  # JSON dict, e.g. {"PYTHONPATH": "./tools"}
DEEPSEARCH_MCP_HEADERS={}  # JSON dict for extra HTTP headers
DEEPSEARCH_MCP_TIMEOUT=30
DEEPSEARCH_MCP_READ_TIMEOUT=300
DEEPSEARCH_MCP_PERSISTENT_SESSION=true
DEEPSEARCH_MCP_ENABLE_GRAPH_CONTEXT=true
DEEPSEARCH_MCP_GRAPH_CONTEXT_FIELD=__graph_context__
# Gap detection thresholds
DEEPSEARCH_GAP_COVERAGE_THRESHOLD=0.7
DEEPSEARCH_GAP_CONFIDENCE_THRESHOLD=0.6
DEEPSEARCH_GAP_EXPECTED_MIN_CHUNKS=3
# Report generation: enable LLM-based consistency check (validates claims against evidence)
DEEPSEARCH_CONSISTENCY_CHECK=true
# Report generation: generate report sections in parallel (faster but uses more API calls)
DEEPSEARCH_PARALLEL_SECTIONS=false

# ============================================
# Application Configuration
# ============================================
# JWT Secret Key - Run: openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-change-this-in-production

# HuggingFace Token (optional, for downloading models)
HF_TOKEN=
# Optional HuggingFace endpoint override (e.g. https://hf-mirror.com)
HF_ENDPOINT=

# Log Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ============================================
# File Storage Configuration
# ============================================
# Unified parser output directory (all parsers output to subdirectories here)
# Structure: {PARSER_OUTPUT_DIR}/native/, {PARSER_OUTPUT_DIR}/dots_ocr/, {PARSER_OUTPUT_DIR}/vlm_ocr/
PARSER_OUTPUT_DIR=./data/parsed_files
# Optional per-parser overrides (leave blank to use PARSER_OUTPUT_DIR subdirectories)
NATIVE_PARSER_OUTPUT_DIR=
DOTSOCR_OUTPUT_DIR=
VLMOCR_OUTPUT_DIR=
# Backward-compatible OCR model name alias (optional)
OCR_MODEL_NAME=
# Fallback path when parser output directory is not writable (e.g., host bind mounts from Docker)
RAGARC_RUNTIME_DIR=./local/runtime

# Local file storage path
LOCAL_FILE_STORAGE_PATH=./local/files

# ============================================
# Neo4j Graph Database Configuration
# ============================================
# Neo4j connection (auto-configured by Docker deployment)
NEO4J_URL=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=12345678
NEO4J_DATABASE=neo4j

# Docker: Expose Neo4j ports to host (default: false for security)
# Set to true if you want to access Neo4j Browser at http://localhost:7474
EXPOSE_NEO4J=false

# Docker: Neo4j port mapping (only used if EXPOSE_NEO4J=true)
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ============================================
# Optional: MinIO Object Storage
# ============================================
# Uncomment if you want to use MinIO
# MINIO_ENDPOINT=localhost:9000
MINIO_USERNAME=ROOTNAME
MINIO_PASSWORD=CHANGEME123

# ============================================
# Build / Advanced Runtime
# ============================================
# Optional: constrain GPU visibility when running local models
CUDA_VISIBLE_DEVICES=
# Optional: extra Python import roots for subprocesses (e.g. vLLM launcher)
PYTHONPATH=
# Optional: override uv installer/index settings used by build.sh
UV_INSTALL_URL=https://astral.sh/uv/install.sh
UV_INDEX_URL=https://pypi.org/simple
# Optional: override PyTorch wheel index used by build.sh (primarily for GPU builds)
PYTORCH_INDEX_URL=

# ============================================
# CLI Defaults
# ============================================
# Optional: pinned owner id used by CLI commands when present
CLI_OWNER_ID=
# Optional: where to persist generated CLI owner id (default: ~/.rag_arc_owner_id)
CLI_OWNER_ID_FILE=
# Optional: legacy aliases checked by CLI owner resolution
DEFAULT_OWNER_ID=
RAG_ARC_OWNER_ID=

# ============================================
# Quick Start / Test Hooks
# ============================================
QUICK_START_OWNER_ID=
RAG_OUTPUT_DIR=
DEEPSEARCH_EXPERIMENT_OUTPUT_DIR=
DEEPSEARCH_CITATION_ALIASES=
DEEPSEARCH_TOOL_AUDIT_LABEL=
DEEPSEARCH_TOOL_MCP_AUDIT_LABEL=
DEEPSEARCH_TOOL_MCP_INSTRUCTIONS=
DEEPSEARCH_TOOL_MCP_SCOPE_OVERRIDE_POLICY=
DEEPSEARCH_TOOL_MCP_SCOPE_OVERRIDE_TOKEN=
DEEPSEARCH_RUN_LLM_INTEGRATION_TESTS=0

# Optional: run local-model smoke tests (pytest) without downloading additional models
RUN_RAGARC_GPT2_CHAT_TESTS=0
RAGARC_GPT2_MODEL_DIR=./models/gpt2
RUN_RAGARC_LOCAL_EMBEDDING_TESTS=0
RAGARC_ST_MODEL_SNAPSHOTS=./models/all-MiniLM-L6-v2/models--sentence-transformers--all-MiniLM-L6-v2/snapshots
RUN_RAGARC_LOCAL_RERANK_TESTS=0
RAGARC_RERANKER_SNAPSHOTS=./models/Qwen/models--Qwen--Qwen3-Reranker-0.6B/snapshots
RAGARC_ALLOW_LARGE_MODELS=0

# ============================================
# Azure OpenAI (Optional)
# ============================================
API_VERSION=
AZURE_OPENAI_API_KEY=

# ============================================
# Test-only placeholders (Register env substitution tests)
# ============================================
APP_NAME=
APP_VALUE=
BASE_URL=
EXISTING_VAR=
LIST_VAR=
MIXED_VAR=
NESTED_VAR=
STRING_VAR=
TEST_VAR=
VAR1=
VAR2=
# MINIO_PASSWORD=CHANGEME123
# MINIO_BUCKET=rag-arc-bucket
# MINIO_SECURE=false

# ============================================
# Integration / Test Flags (optional)
# ============================================
# Set to 1 (or any non-empty value) to opt-in when the required services/models are available.
# Leave empty to skip those suites.
RUN_RAGARC_INTEGRATION_TESTS=
RUN_RAGARC_POSTGRES_TESTS=
RUN_RAGARC_CHAT_STORAGE_TESTS=
RUN_RAGARC_VECTOR_TESTS=
# Token used by test/test_complete_e2e_api.py to authenticate API requests
RAGARC_E2E_TOKEN=
