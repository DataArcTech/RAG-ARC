#
# Minimal .env template
# - Secrets and feature switches only.
# - All tunable parameters (top_k/thresholds/budgets/paths/etc.) live in `config/`.
#
# Full reference and advanced configuration:
# - English: `config/env-en.md`
# - 中文: `config/env-zh.md`
#

# ==========================
# Required: LLM credentials
# ==========================
# If you use any OpenAI-compatible provider (OpenAI/DeepSeek/etc.), set these:
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: if chat/embedding/OCR use different provider credentials, set component-specific values.
CHAT_API_KEY=
CHAT_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_API_BASE_URL=
OCR_API_KEY=
OCR_API_BASE_URL=

# ==========================
# Optional: local models (no API)
# ==========================
# Chat local (Transformers)
# - Set CHAT_MODEL_PROVIDER=huggingface
# - Set CHAT_MODEL_NAME to a HuggingFace repo id or a local filesystem path
# CHAT_MODEL_PROVIDER=huggingface
# CHAT_MODEL_NAME=
# CHAT_MODEL_DEVICE=cpu
# CHAT_MODEL_CACHE_FOLDER=

# Embedding local (SentenceTransformers)
# - Set EMBEDDING_MODEL_PROVIDER=huggingface
# - Set EMBEDDING_MODEL_NAME to a HuggingFace repo id or a local filesystem path
# EMBEDDING_MODEL_PROVIDER=huggingface
# EMBEDDING_MODEL_NAME=
# EMBEDDING_DEVICE=cpu
# EMBEDDING_CACHE_FOLDER=
# Optional override; when empty, the system can auto-detect and cache the dimension.
# EMBEDDING_DIMENSIONS=

# ==========================
# Optional: enable features
# ==========================
# Switch between Celery and in-process background execution.
TASK_QUEUE_MODE=celery  # celery|inprocess
# Select default JSON config profile.
MODEL_PROFILE=api  # api|local
# Local dev convenience switches.
DEVELOP_MODE=false
# Optional admin UUID allowed to inspect cross-tenant data (leave empty to disable).
ADMIN_OWNER_ID=

# Optional: external web search (only needed when enabled in config).
TAVILY_API_KEY=

# ==========================
# Optional: infrastructure (Neo4j / PostgreSQL / Redis)
# ==========================
# These have sane defaults in code for local/Docker use. Set them only when you run services elsewhere.

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5555
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123
POSTGRES_DB=rag_arc

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Neo4j
NEO4J_URL=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=12345678
NEO4J_DATABASE=neo4j

# ==========================
# API authentication
# ==========================
# Optional: JWT signing secret.
# - If empty, the API auto-generates one and persists it under `RAGARC_RUNTIME_DIR` (default: `./local/runtime/jwt_secret_key`).
# - For production deployments, set it explicitly (generate with: `openssl rand -hex 32`).
JWT_SECRET_KEY=

# Optional: HuggingFace token (only needed for gated model downloads)
HF_TOKEN=

# ==========================
# Test / integration flags
# ==========================
# Set to 1 (or any non-empty value) to opt-in when the required services/models are available.
RUN_RAGARC_INTEGRATION_TESTS=
RUN_RAGARC_POSTGRES_TESTS=
RUN_RAGARC_CHAT_STORAGE_TESTS=
RUN_RAGARC_VECTOR_TESTS=
# Opt-in: run real-Redis message-queue stress smoke tests (pytest)
RUN_RAGARC_MQ_STRESS_TESTS=
RAGARC_E2E_TOKEN=
