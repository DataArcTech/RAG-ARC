#
# Minimal .env template
# - Secrets and feature switches only.
# - All tunable parameters (top_k/thresholds/budgets/paths/etc.) live in `config/`.
#
# Full reference and advanced configuration:
# - English: `config/env-en.md`
# - 中文: `config/env-zh.md`
#

# ==========================
# Required: LLM credentials
# ==========================
# If you use any OpenAI-compatible provider (OpenAI/DeepSeek/etc.), set these:
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional: normalize OpenRouter-style model names for embedding fingerprinting.
# Example: {"openai/text-embedding-3-small":"text-embedding-3-small","openai/text-embedding-3-large":"text-embedding-3-large"}
# EMBEDDING_MODEL_NAME_ALIASES={"openai/text-embedding-3-small":"text-embedding-3-small"}

# Optional: if chat/embedding/OCR use different provider credentials, set component-specific values.
CHAT_API_KEY=
CHAT_API_BASE_URL=
# Optional: cheaper model used for exploration-heavy calls (planning/reflection/quality checks).
# When empty, the system reuses the main chat model.
LOW_COST_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_API_BASE_URL=
OCR_API_KEY=
OCR_API_BASE_URL=

# ==========================
# Optional: semantic intent routing (TOML-driven)
# ==========================
# Path to the TOML intent router config.
# INTENT_ROUTER_CONFIG_PATH=config/core/intent_routing/intent_router.toml
#
# Intent embedding is decoupled from RAG embedding:
# - For OpenAI-compatible intent embeddings, set:
# INTENT_EMBEDDING_API_KEY=
# INTENT_EMBEDDING_API_BASE_URL=
# INTENT_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
#
# - For local intent embeddings (SentenceTransformers / Qwen):
# INTENT_QWEN_EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
# INTENT_EMBEDDING_DEVICE=cpu
# INTENT_EMBEDDING_CACHE_FOLDER=./models/Qwen

# Optional: web search (recommended when calling chat endpoints via curl).
# - Both HippoRAG Q&A (`/rag_inference/stream_chat/{session_id}`) and DeepSearch can use Tavily when enabled in `config/`.
TAVILY_API_KEY=

# ==========================
# Optional: DeepSearch runtime
# ==========================
# Plan artifacts directory (JSON plans are persisted here when enabled in DeepSearch config).
DEEPSEARCH_PLAN_OUTPUT_DIR=./local/deepsearch_runs
# Tool artifacts directory (per-run trace + tool payload snapshots).
DEEPSEARCH_TOOL_ARTIFACT_DIR=./local/deepsearch_artifacts

# ==========================
# Optional: local models (no API)
# ==========================
# Chat local (Transformers)
# - Set CHAT_MODEL_PROVIDER=huggingface
# - Set CHAT_MODEL_NAME to a HuggingFace repo id or a local filesystem path
# CHAT_MODEL_PROVIDER=huggingface
# CHAT_MODEL_NAME=
# CHAT_MODEL_DEVICE=cpu
# CHAT_MODEL_CACHE_FOLDER=

# Embedding local (SentenceTransformers)
# - Set EMBEDDING_MODEL_PROVIDER=huggingface
# - Set EMBEDDING_MODEL_NAME to a HuggingFace repo id or a local filesystem path
# - For OpenAI-compatible embeddings, prefer OPENAI_EMBEDDING_MODEL (it overrides EMBEDDING_MODEL_NAME when provider=openai)
# EMBEDDING_MODEL_PROVIDER=huggingface
# EMBEDDING_MODEL_NAME=
# EMBEDDING_DEVICE=cpu
# EMBEDDING_CACHE_FOLDER=
# Optional override; when empty, the system can auto-detect and cache the dimension.
# EMBEDDING_DIMENSIONS=

# ==========================
# Optional: enable features
# ==========================
# Benchmark/experiment mode (GraphRAG-Benchmark alignment).
# - 0: normal product mode (default)
# - 1: benchmark mode (disable rewrite/web-search/citations/guardrails where applicable)
bench_mode=0
# Switch between Celery and in-process background execution.
TASK_QUEUE_MODE=celery  # celery|inprocess
# Select default JSON config profile.
MODEL_PROFILE=api  # api|local
# Local dev convenience switches. Note: Only in develop_mode can you use cli.
DEVELOP_MODE=false
# Optional admin UUID allowed to inspect cross-tenant data (leave empty to disable).
ADMIN_OWNER_ID=
# Optional org admin UUID allowlist (comma-separated). Used to authorize CRUD operations on shared library (SHARE_OWNER_ID).
ORG_ADMIN_OWNER_IDS=
# Optional shared owner UUID for enterprise "share" knowledge domain (leave empty to disable share-merged retrieval).
# Must be different from ADMIN_OWNER_ID.
SHARE_OWNER_ID=
# Shared owner UUID used for chatKB (type=1) unified retrieval across users.
# Index chatKB documents under this owner ID to make them searchable in the chatbot.
CHATBOT_SHARED_DOCUMENT_OWNER_ID=

# ==========================
# Optional: index paths
# ==========================
# IMPORTANT: indexing and retrieval must use the same paths; otherwise the system may retrieve
# irrelevant files even though the target file/chunks exist in Neo4j / chunk_store.
# Defaults (when unset): see `config/env-zh.md` / `config/env-en.md`.
GRAPH_STORAGE_PATH=./data/graph_index_neo4j
FAISS_INDEX_PATH=./data/unified_faiss_index
# Optional: two-stage retrieval for FAISS HNSW (ANN prefetch -> exact rescoring).
# Applies only when the corresponding FAISS config uses index_type=hnsw.
FAISS_TWO_STAGE_ENABLED=false
# Candidate pool size for HNSW prefetch. If smaller than k, k is used.
FAISS_TWO_STAGE_PREFETCH_K=200
# Optional: IVF training guard (only relevant when index_type=ivf).
FAISS_MIN_TRAIN_SIZE=100
BM25_INDEX_PATH=./data/unified_bm25_index

# ==========================
# Optional: PageIndex section tree + doc routing
# ==========================
# See `config/env-zh.md` / `config/env-en.md` for all related knobs.
PAGEINDEX_ENABLED=true
SECTION_INDEX_ENABLED=true
SECTION_FAISS_INDEX_PATH=./data/section_faiss_index
# Optional override for the PageIndex *section* FAISS index type (default: "flat").
# Allowed: flat | ivf | hnsw
SECTION_FAISS_INDEX_TYPE=flat
# Optional override for two-stage retrieval on the PageIndex *section* FAISS index (default: inherit base FAISS config).
# Applies only when the section index uses `index_type=hnsw`.
# Allowed: true | false | (empty to inherit)
SECTION_FAISS_TWO_STAGE_ENABLED=
# Optional override for section two-stage prefetch size (default: inherit base FAISS config).
SECTION_FAISS_TWO_STAGE_PREFETCH_K=
SECTION_BM25_INDEX_PATH=./data/section_bm25_index
# PageIndex truncation controls.
PAGEINDEX_TOC_CHECK_PAGE_NUM=20
PAGEINDEX_MAX_PAGE_NUM_EACH_NODE=10
PAGEINDEX_MAX_TOKEN_NUM_EACH_NODE=20000
# Section path delimiter used by PageIndex tree (default: " > ").
SECTION_PATH_DELIMITER=" > "
SECTION_SUMMARY_ENABLED=true
SECTION_SUMMARY_MODEL=

# ==========================
# Optional: graph embedding robustness
# ==========================
# Controls how Neo4j HippoRAG index building handles embedding failures.
# - "zero": tolerate a small number of per-item failures and fill failed items with zero vectors (still logged).
# - "raise": fail the indexing task when any embedding fails.
GRAPH_INDEX_EMBED_FAILURE_POLICY=zero
# Even in "zero" mode, fail fast if failures exceed these safety thresholds.
GRAPH_INDEX_EMBED_MAX_FAILURE_RATIO=0.05
GRAPH_INDEX_EMBED_MAX_FAILURE_COUNT=50

# ==========================
# Optional: query variants (retrieval-time)
# ==========================
# Deterministic query variants used by the MultiPath retriever to improve recall on mixed corpora.
# Simplified/Traditional Chinese conversion requires OpenCC.
QUERY_VARIANTS_ENABLED=true
QUERY_VARIANTS_ZH_HANS_HANT_ENABLED=true
QUERY_VARIANTS_MAX=3
# Query variants are generated by the low-cost chat model (set LOW_COST_MODEL) and returned as JSON per language.

# ==========================
# Optional: DeepSearch tool MCP server
# ==========================
# Default scope injected into the standalone tool MCP server (`uv run rag-arc tool-mcp-server ...`).
# This should be a UUID string representing the owner/tenant you want the tools to run under.
DEEPSEARCH_TOOL_MCP_SCOPE_ID=
DEEPSEARCH_TOOL_MCP_SCOPE_TYPE=owner
DEEPSEARCH_TOOL_MCP_SCOPE_LABELS=[]
DEEPSEARCH_TOOL_MCP_SCOPE_ATTRIBUTES={}
# Optional comma-separated tool allowlist for the tool MCP server.
DEEPSEARCH_TOOL_MCP_TOOLS=
DEEPSEARCH_TOOL_MCP_AUDIT_LABEL=

# Optional: graph export filters (visualization).
# - Default is true (filter pure numbers/dates to reduce clutter).
# - Set to false for finance/insurance graphs where numeric/time entities are important.
GRAPH_EXPORT_FILTER_NUMERIC_TIME_ENTITIES=true

# ==========================
# Optional: infrastructure (Neo4j / PostgreSQL / Redis)
# ==========================
# These have sane defaults in code for local/Docker use. Set them only when you run services elsewhere.

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5555
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123
POSTGRES_DB=rag_arc

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Neo4j
NEO4J_URL=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# KG schema (Neo4j HippoRAG)
# KG_SCHEMA_PATH=./kg_schema.yml
# Optional (finance/insurance schema): KG_SCHEMA_PATH=./fin_kg_schema.yml

# Dependency health checks
# - API startup defaults to strict unless overridden.
# - Indexing tasks can be relaxed/disabled independently.
# RAGARC_DEPENDENCY_CHECK_MODE=warn   # off|warn|strict
# RAGARC_INDEXING_DEPENDENCY_CHECK_MODE=strict  # off|warn|strict

# ==========================
# API authentication
# ==========================
# Optional: JWT signing secret.
# - If empty, the API auto-generates one and persists it under `RAGARC_RUNTIME_DIR` (default: `./local/runtime/jwt_secret_key`).
# - For production deployments, set it explicitly (generate with: `openssl rand -hex 32`).
JWT_SECRET_KEY=

# Optional: HuggingFace token (only needed for gated model downloads)
HF_TOKEN=

# ==========================
# Optional: parsing mode (PDF/images)
# ==========================
# native: no OCR; PDF text extraction only (default)
# dotsocr: local DotsOCR OCR
# mineru: remote MinerU parsing service (recommended for complex PDFs)
# PARSER_PARSE_MODE=native
# When PARSER_PARSE_MODE=mineru, set:
# MINERU_SERVER_URL=http://127.0.0.1:8899
# Optional: retry transient MinerU HTTP errors (e.g., SSH tunnel hiccups / keep-alive disconnects).
# MINERU_HTTP_MAX_RETRIES=3
# MINERU_HTTP_RETRY_BACKOFF_S=1.0
# MINERU_HTTP_RETRY_MAX_BACKOFF_S=8.0
# MINERU_BACKEND=vlm-http-client
#   - vlm-transformers: MinerU server runs local VLM via transformers (single GPU).
#   - vlm-http-client: MinerU server forwards to an OpenAI-compatible VLM (e.g., vLLM).
#   - vlm-vllm-async-engine: MinerU server runs in-process vLLM async engine.
#   - hybrid-http-client: MinerU hybrid pipeline with external VLM via OpenAI-compatible API.
#   - (others): any backend name supported by your MinerU build.
# Note: MinerU server can ignore this value when enforce-backend is enabled
# (server env `MINERU_SERVER_ENFORCE_BACKEND=1` or `--enforce-backend`).
# Optional: when PARSER_PARSE_MODE=mineru, allow falling back to native PDF text extraction on MinerU failures.
# - Set to 0/false to fail fast and make parsing issues observable.
# MINERU_FALLBACK_TO_NATIVE_ON_FAILURE=false
# Optional: reuse existing MinerU markdown artifacts under PARSER_OUTPUT_DIR/mineru/<file_id>/
# when re-indexing (skip remote MinerU call if cached markdown exists).
# MINERU_REUSE_CACHE=1
# MINERU_TIMEOUT_S=900
# MINERU_POLL_INTERVAL_S=5
# MINERU_POLL_TIMEOUT_S=0
# Optional (0-based page range, inclusive end):
# MINERU_START_PAGE=0
# MINERU_END_PAGE=1

# ==========================
# Optional: chunking knobs
# ==========================
# Token chunking defaults (used by token_chunker and as semantic_unit_chunker fallback).
# TOKEN_CHUNK_SIZE=1000
# TOKEN_CHUNK_OVERLAP=100
# Semantic unit chunking level (semantic_unit_chunker).
# - disabled: fallback only
# - basic: tables
# - standard: tables + fenced code + lists + math blocks
# - advanced: standard + blockquotes
SEMANTIC_CHUNKING_LEVEL=standard

# ==========================
# Optional: index text augmentation (retrieval/rerank quality)
# ==========================
# When enabled, we prepend a filename-derived title hint to each chunk's `metadata.index_text`.
# This improves recall for file-scoped/product-scoped queries where the name appears mainly in
# the filename rather than in every chunk body.
# INDEX_TEXT_TITLE_PREFIX_ENABLED=true
# INDEX_TEXT_TITLE_MAX_CHARS=160

# ==========================
# Optional: retrieval query variants (mixed-language corpora)
# ==========================
# Generate lightweight retrieval-time query variants and union results per retriever.
# - zh-Hans/zh-Hant: OpenCC conversion (when installed)
# - en: best-effort ASCII token extraction (no translation)
QUERY_VARIANTS_LANGS=zh-Hans,en,zh-Hant

# ==========================
# Optional: MultiPath fusion weights (RAG inference)
# ==========================
# RRF fusion weights aligned with `config/json_configs/rag_inference*.json` retrievers:
# [dense, bm25, graph]
RAG_RETRIEVAL_WEIGHT_DENSE=1.0
RAG_RETRIEVAL_WEIGHT_BM25=1.0
# Default to disabling graph retrieval for *normal RAG* to reduce latency.
# Note: this does NOT disable graph indexing/ingestion. The graph index can still be built and used by DeepSearch.
# Set this to a positive value (e.g. 1.0) to enable graph retrieval in normal RAG.
RAG_RETRIEVAL_WEIGHT_GRAPH=0.0

# Enable LLM-driven, per-query routing ratios for MultiPath quota (coverage floor).
# When disabled, the system falls back to the static ratios implied by the weights above.
RAG_RETRIEVAL_DYNAMIC_QUOTA_ENABLED=true

# ==========================
# Optional: multimodal image limits
# ==========================
# When using MinerU, parsed markdown can reference local image assets (images/*).
# If the configured LLM supports multimodal inputs, RAG-ARC will attach a limited number of images to requests.
# Set to 0 (or any negative value) to remove the limit.
# CHAT_MAX_IMAGE_INPUTS=4
# DEEPSEARCH_MAX_IMAGE_INPUTS=6

# ==========================
# Test / integration flags
# ==========================
# Set to 1 (or any non-empty value) to opt-in when the required services/models are available.
RUN_RAGARC_INTEGRATION_TESTS=
RUN_RAGARC_POSTGRES_TESTS=
RUN_RAGARC_CHAT_STORAGE_TESTS=
RUN_RAGARC_VECTOR_TESTS=
# Opt-in: run real-Redis message-queue stress smoke tests (pytest)
RUN_RAGARC_MQ_STRESS_TESTS=
RAGARC_E2E_TOKEN=
