                    },
                    "entity_faiss_config": {
                        "type": "faiss",
                        "index_path": "./data/graph_index/entity_index",
                        "metric": "cosine",
                        "index_type": "hnsw",
                        "normalize_L2": true,
                        "hnsw_m": 16,
                        "hnsw_ef_construction": 200,
                        "hnsw_ef_search": 50
                    },
                    "add_synonymy_edges": true,
                    "synonymy_edge_topk": 100,
                    "synonymy_edge_sim_threshold": 0.8
                }
            },
            {
                "type": "faiss_indexer",
                "index_config": {
                    "type": "faiss",
                    "index_path": "./data/unified_faiss_index",
                    "metric": "cosine",
                    "index_type": "flat",
                    "normalize_L2": true,
                    "embedding_config": {
                        "type": "qwen_embedding",
                        "model_name": "Qwen/Qwen3-Embedding-0.6B",
                        "device": "cuda:0",
                        "use_china_mirror": true,
                        "cache_folder": "./models/Qwen"
                    }
                }
            },
            {
                "type": "bm25_indexer",
                "index_config": {
                    "type": "bm25_builder",
                    "index_path": "./data/unified_bm25_index"
                }
            }
