{
    "max_concurrent_indexing": 5,
    "file_storage_config": {
        "type": "file_storage",
        "file_db_config": {
            "type": "oss_blob_store",
            "object_key_prefix": "${OSS_FILE_PREFIX}"
        },
        "relational_db_config": {
            "type": "postgresql",
            "host": "${POSTGRES_HOST}",
            "port": "${POSTGRES_PORT}",
            "database": "${POSTGRES_DB}",
            "user": "${POSTGRES_USER}",
            "password": "${POSTGRES_PASSWORD}"
        }
    },
    "index_manager_config": {
        "type": "index_manager",
        "file_storage_config": {
            "type": "file_storage",
            "file_db_config": {
                "type": "oss_blob_store",
                "object_key_prefix": "${OSS_FILE_PREFIX}"
            },
            "relational_db_config": {
                "type": "postgresql",
                "host": "${POSTGRES_HOST}",
                "port": "${POSTGRES_PORT}",
                "database": "${POSTGRES_DB}",
                "user": "${POSTGRES_USER}",
                "password": "${POSTGRES_PASSWORD}"
            }
        },
        "parsed_content_storage_config": {
            "type": "parsed_content_storage",
            "file_db_config": {
                "type": "oss_blob_store",
                "object_key_prefix": "${OSS_PARSED_CONTENT_PREFIX}"
            },
            "relational_db_config": {
                "type": "postgresql",
                "host": "${POSTGRES_HOST}",
                "port": "${POSTGRES_PORT}",
                "database": "${POSTGRES_DB}",
                "user": "${POSTGRES_USER}",
                "password": "${POSTGRES_PASSWORD}"
            }
        },
        "chunk_storage_config": {
            "type": "chunk_storage",
            "file_db_config": {
                "type": "oss_blob_store",
                "object_key_prefix": "${OSS_CHUNK_PREFIX}"
            },
            "relational_db_config": {
                "type": "postgresql",
                "host": "${POSTGRES_HOST}",
                "port": "${POSTGRES_PORT}",
                "database": "${POSTGRES_DB}",
                "user": "${POSTGRES_USER}",
                "password": "${POSTGRES_PASSWORD}"
            }
        },
        "parser_config": {
            "type": "parser_combinator",
            "base_output_dir": "${PARSER_OUTPUT_DIR}",
            "ocr_parser": {
                "type": "vlm_ocr_parser",
                "vlm_ocr": {
                    "type": "vlm_ocr",
                    "loading_method": "openai",
                    "model_name": "${OPENAI_OCR_MODEL}",
                    "max_tokens": 4096,
                    "temperature": 0.0
                },
                "num_threads": 4
            },
            "mineru_parser": {
                "type": "mineru_parser"
            },
            "native_parser": {
                "type": "native_parser"
            }
        },
        "chunker_config": {
            "type": "semantic_unit_chunker",
            "level": "standard",
            "fallback_chunker_config": {
                "type": "token_chunker",
                "chunk_size": "${TOKEN_CHUNK_SIZE}",
                "chunk_overlap": "${TOKEN_CHUNK_OVERLAP}"
            }
        },
        "indexer_configs": [
            {
                "type": "pruned_hipporag_neo4j_indexer",
                "extractor_config": {
                    "type": "hipporag2_extractor",
                    "llm_config": {
                        "type": "openai_chat",
                        "model_name": "${OPENAI_CHAT_MODEL}",
                        "temperature": 0.0
                    },
                    "max_concurrent": 10,
                    "batch_size": 5,
                    "retry_attempts": 3,
                    "timeout": 60
                },
                "graph_store_config": {
                    "type": "pruned_hipporag_neo4j",
                    "url": "${NEO4J_URL}",
                    "username": "${NEO4J_USERNAME}",
                    "password": "${NEO4J_PASSWORD}",
                    "database": "${NEO4J_DATABASE}",
                    "storage_path": "${GRAPH_STORAGE_PATH}",
                    "index_name": "${GRAPH_INDEX_NAME}",
                    "neo4j_ingest_chunk_batch_size": 250,
                    "embedding": {
                        "type": "openai_embedding",
                        "model_name": "${OPENAI_EMBEDDING_MODEL}",
                        "embedding_dimensions": "${EMBEDDING_DIMENSIONS}"
                    },
                    "embedding_cache": {
                        "type": "graph_embedding_cache",
                        "enabled": true,
                        "dirname": "embedding_cache",
                        "db_filename": "embeddings.sqlite3",
                        "max_in_keys_per_query": 500
                    },
                    "add_synonymy_edges": true,
                    "synonymy_edge_topk": 100,
                    "synonymy_edge_sim_threshold": 0.8,
                    "use_float16_embeddings": true,
                    "normalize_chunk_embeddings": true,
                    "chunk_embedding_text_prefix_keys": ["filename"],
                    "chunk_embedding_filename_root": "RAG-ARC",
                    "chunk_embedding_text_separator": "\n"
                }
            },
            {
                "type": "faiss_indexer",
                "index_config": {
                    "type": "faiss",
                    "index_path": "${FAISS_INDEX_PATH}",
                    "metric": "cosine",
                    "index_type": "flat",
                    "normalize_L2": true,
                    "embedding_text_prefix_keys": ["filename"],
                    "embedding_text_filename_root": "RAG-ARC",
                    "embedding_text_separator": "\n",
                    "embedding_config": {
                        "type": "openai_embedding",
                        "model_name": "${OPENAI_EMBEDDING_MODEL}",
                        "embedding_dimensions": "${EMBEDDING_DIMENSIONS}"
                    }
                }
            },
            {
                "type": "bm25_indexer",
                "index_config": {
                    "type": "bm25_builder",
                    "index_path": "${BM25_INDEX_PATH}",
                    "token_text_prefix_keys": ["filename"],
                    "token_text_filename_root": "RAG-ARC",
                    "token_text_separator": "\n"
                }
            }
        ]
    }
}
