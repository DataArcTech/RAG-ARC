{
    "type": "rag_inference",
    "query_rewrite_config": {
        "type": "llm_query_rewriter",
        "chat_llm_config": {
            "type": "openai_chat",
            "model_name": "${OPENAI_CHAT_MODEL}",
            "temperature": 0.0
        }
    },
    "retrieval_config": {
        "type": "multipath",
        "retrievers": [
            {
                "type": "dense",
                "index_config": {
                    "index_path": "${FAISS_INDEX_PATH}",
                    "metric": "cosine",
                    "index_type": "flat",
                    "normalize_L2": true,
                    "embedding_text_prefix_keys": ["filename"],
                    "embedding_text_filename_root": "RAG-ARC",
                    "embedding_text_separator": "\n",
                    "embedding_config": {
                        "type": "openai_embedding",
                        "model_name": "${OPENAI_EMBEDDING_MODEL}",
                        "embedding_dimensions": "${EMBEDDING_DIMENSIONS}"
                    }
                }
            },
  {
    "type": "tantivy_bm25",
    "index_config": {
      "type": "bm25_builder",
      "index_path": "${BM25_INDEX_PATH}",
      "token_text_prefix_keys": ["filename"],
      "token_text_filename_root": "RAG-ARC",
      "token_text_separator": "\n"
    }
  },
            {
                "type": "pruned_hipporag_neo4j_retrieval",
                "graph_config": {
                    "type": "pruned_hipporag_neo4j",
                    "url": "${NEO4J_URL}",
                    "username": "${NEO4J_USERNAME}",
                    "password": "${NEO4J_PASSWORD}",
                    "database": "${NEO4J_DATABASE}",
                    "storage_path": "${GRAPH_STORAGE_PATH}",
                    "index_name": "${GRAPH_INDEX_NAME}",
                    "embedding": {
                        "type": "openai_embedding",
                        "model_name": "${OPENAI_EMBEDDING_MODEL}",
                        "embedding_dimensions": "${EMBEDDING_DIMENSIONS}"
                    },
                    "add_synonymy_edges": true,
                    "synonymy_edge_topk": 100,
                    "synonymy_edge_sim_threshold": 0.8,
                    "use_float16_embeddings": true,
                    "normalize_chunk_embeddings": true,
                    "chunk_embedding_text_prefix_keys": ["filename"],
                    "chunk_embedding_filename_root": "RAG-ARC",
                    "chunk_embedding_text_separator": "\n"
                },
                "llm_config": {
                    "type": "openai_chat",
                    "model_name": "${OPENAI_CHAT_MODEL}",
                    "temperature": 0.0
                },
                "fact_retrieval_top_k": 10,
                "max_facts_after_reranking": 5,
                "enable_llm_reranking": true,
                "damping_factor": 0.3,
                "ppr_backend": "push",
                "ppr_directed_mode": "off",
                "ppr_push_threshold_mode": "residual_over_degree",
                "ppr_push_target_degree_penalty_gamma": 0.5,
                "entity_reset_weight_aggregation": "sum_avg",
                "dense_file_closure_enabled": true,
                "ppr_push_epsilon": 0.000001
            }
        ],
        "fusion_method": "rrf",
        "rrf_k": 60,
        "weights": [1.0, 1.0, 3.0],
        "search_kwargs": {
            "k": 30,
            "with_score": true
        }
    },
    "reranker_config": {
        "type": "llm_reranker",
	        "rerank_llm_config": {
	            "type": "listwise_rerank",
	            "chat_llm_config": {
	                "type": "openai_chat",
	                "model_name": "${OPENAI_CHAT_MODEL}",
	                "temperature": 0.0,
	                "openai_api_key": "${CHAT_API_KEY}",
	                "openai_base_url": "${CHAT_API_BASE_URL}"
	            }
	        }
	    },
    "llm_config": {
        "type": "openai_chat",
        "model_name": "${OPENAI_CHAT_MODEL}"
    },
    "web_search": {
        "enabled": true,
        "endpoint_url": "https://api.tavily.com/search",
        "api_key": "${TAVILY_API_KEY}",
        "search_depth": "advanced",
        "timeout_seconds": 20.0,
        "timeout_grace_seconds": 2.0,
        "max_results": 5
    },
    "candidate_selection": {
        "graph_candidates_k": 30,
        "web_candidates_k": 5,
        "rerank_keep_k": 10
    }
}
