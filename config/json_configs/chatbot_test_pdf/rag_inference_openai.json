{
  "type": "rag_inference",
  "query_rewrite_config": {
    "type": "llm_query_rewriter",
    "chat_llm_config": {
      "type": "openai_chat",
      "model_name": "${OPENAI_CHAT_MODEL}",
      "temperature": 0.0
    }
  },
  "retrieval_config": {
    "type": "multipath",
    "retrievers": [
      {
        "type": "tantivy_bm25",
        "index_config": {
          "type": "bm25_builder",
          "index_path": "./test_output/chatbot_bm25_index"
        },
        "search_kwargs": {
          "k": 5,
          "with_score": true,
          "use_phrase_query": false
        }
      }
    ],
    "fusion_method": "rrf",
    "rrf_k": 60,
    "search_kwargs": {
      "k": 5,
      "with_score": true
    }
  },
  "reranker_config": {
    "type": "noop_reranker"
  },
  "llm_config": {
    "type": "openai_chat",
    "model_name": "${OPENAI_CHAT_MODEL}",
    "temperature": 0.2
  }
}

