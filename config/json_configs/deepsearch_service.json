{
  "type": "deepsearch_service",
  "planner": {
    "mode": "react",
    "max_steps": 8,
    "enable_sub_question": true,
    "persist_plan": true,
    "plan_output_dir": "${DEEPSEARCH_PLAN_OUTPUT_DIR}",
    "allow_external_channel": false,
    "honor_planner_tool_selection": true,
    "graph_channel_tool": "graph_adapter.query",
    "text_channel_tool": "graph.context_rollup",
    "web_channel_tool": "web.search",
    "include_llm_tools_in_catalog": true,
    "default_web_provider": "${DEEPSEARCH_WEB_PROVIDER}",
    "graph_adapter_name": "${DEEPSEARCH_DEFAULT_ADAPTER}",
    "tool_arg_templates": {}
  },
  "graph_adapter": {
    "type": "graph_adapter",
    "adapter_name": "hipporag",
    "parameters": {
      "retriever_config": {
        "type": "pruned_hipporag_neo4j_retrieval",
        "graph_config": {
          "type": "pruned_hipporag_neo4j",
          "url": "${NEO4J_URL}",
          "username": "${NEO4J_USERNAME}",
          "password": "${NEO4J_PASSWORD}",
          "database": "${NEO4J_DATABASE}",
          "storage_path": "${GRAPH_STORAGE_PATH}",
          "index_name": "${GRAPH_INDEX_NAME}",
          "embedding": {
            "type": "openai_embedding",
            "model_name": "${OPENAI_EMBEDDING_MODEL}",
            "embedding_dimensions": "${EMBEDDING_DIMENSIONS}",
            "openai_api_key": "${OPENAI_API_KEY}",
            "openai_base_url": "${OPENAI_BASE_URL}"
          },
          "add_synonymy_edges": true,
          "synonymy_edge_topk": 100,
          "synonymy_edge_sim_threshold": 0.8,
          "use_float16_embeddings": true,
          "normalize_chunk_embeddings": true
        },
        "llm_config": {
          "type": "openai_chat",
          "model_name": "${OPENAI_CHAT_MODEL}",
          "low_cost_model_name": "${LOW_COST_MODEL}",
          "temperature": 0.0,
          "openai_api_key": "${OPENAI_API_KEY}",
          "openai_base_url": "${OPENAI_BASE_URL}"
        },
        "fact_retrieval_top_k": 10,
        "max_facts_after_reranking": 5,
        "enable_llm_reranking": true,
        "damping_factor": 0.5,
        "ppr_backend": "push"
      }
    }
  },
  "graph_reasoning": {
    "strategy_name": "ppr_chain",
    "allow_semantic_channel": true,
    "chain_depth": 4,
    "enable_custom_hooks": false,
    "tool_context_max_evidences": 5,
    "tool_context_max_chars": 800,
    "compression": {
      "tool_context": {
        "mode": "truncate",
        "max_items": 5,
        "max_chars": 800,
        "excerpt_chars": 900,
        "retention": "tail"
      },
      "think": {
        "mode": "truncate",
        "max_items": 8,
        "max_chars": 1600,
        "excerpt_chars": 900,
        "retention": "head"
      }
    },
    "coverage_expected_min_chunks": 3,
    "trace_reflection_enabled": true,
    "trace_reflection_max": 24,
    "step_summary_max_chars": 2000,
    "parallel_branches": 1,
    "tool_timeout_seconds": 45.0,
    "think": {
      "tool_name": "graph.think",
      "every_n_steps": 2,
      "min_coverage": 0.75,
      "enable_tool_calls": true,
      "max_tool_calls": 4,
      "tool_call_concurrency": 2,
      "tool_catalog_max_items": 30,
      "include_llm_tools": true,
      "max_rounds_per_checkpoint": 2
    }
  },
  "multi_agent": {
    "enabled": true,
    "max_subagents": 4,
    "subagent_concurrency": 4,
    "enable_parallel_tool_probes": true,
    "probe_tool_names": ["graph.chunk_scan", "graph.pattern_scan"],
    "probe_concurrency": 4,
    "lead_tool_names": ["graph.context_rollup", "graph.evidence_crosscheck"],
    "lead_tool_concurrency": 2,
    "max_merge_evidences": 60,
    "worker_timeout_seconds": null,
    "worker_retry_attempts": 0,
    "fail_fast": false,
    "incremental_parallelism": true,
    "initial_worker_count": 1,
    "stop_min_evidence_count": 3,
    "stop_min_coverage_ratio": 0.85
  },
  "gap_detection": {
    "coverage_threshold": 0.7,
    "confidence_threshold": 0.6,
    "expected_min_chunks": 3,
    "enable_external_on_gap": true
  },
  "reporter": {
    "max_highlights": 6,
    "include_graph_viz": true,
    "enable_custom_summary": false,
    "parallel_thinking_runs": 1,
    "enable_llm_report": true,
    "include_appendices_in_answer": false,
    "report_temperature": 0.2,
    "report_max_evidence_chars": 900,
    "max_evidence_items": 10,
    "provenance_chunk_attach_max": 10,
    "report_max_graph_chain_items": 200,
    "report_max_seed_entities": 15,
    "enable_consistency_check": true,
    "consistency_temperature": 0.0,
    "consistency_max_retries": 2,
    "sectionwise_writer": true,
    "sectionwise_retain_k": 5,
    "citation_aliases": true,
    "outline_evidence_summary_chars": 240,
    "methodology_summary_chars": 1200,
    "keep_tool_results": 8,
    "enable_citation_agent": true,
    "parallel_sections": false,
    "max_parallel_sections": 4,
    "consistency_max_claims": 40,
    "synthesis_section_max_chars": 1200
  },
  "tool_manager": {
    "enable_builtin_tools": true,
    "enabled_tools": {
      "graph.beam_search": {
        "params": {
          "beam_size": 3,
          "max_depth": 3,
          "temperature": 0.2,
          "pattern_probe_max_terms": 6
        }
      },
      "code.python": {
        "params": {
          "allowed_imports": ["json", "math", "decimal", "fractions", "statistics", "datetime", "numpy", "pandas", "scipy"],
          "timeout_seconds": 6.0,
          "max_code_chars": 12000,
          "max_stdout_chars": 8000,
          "max_stderr_chars": 8000,
          "max_result_chars": 12000,
          "max_memory_mb": 1024,
          "emit_result_evidence": true,
          "disable_file_io": true
        }
      }
    },
    "audit_label": "${DEEPSEARCH_TOOL_AUDIT_LABEL}",
    "artifact_dir": "${DEEPSEARCH_TOOL_ARTIFACT_DIR}",
    "max_remote_evidences": 32,
    "max_remote_context_chars": 4096,
    "remote_tools": {}
  },
  "external_channel": {
    "default_provider": "tavily",
    "max_rounds": 2,
    "enabled": false,
    "context_window_limit": 12,
    "http_timeout": 20.0,
    "max_results": 5,
    "tool_timeout_seconds": 45.0,
    "cache_mode": "auto",
    "cache_dir": "${DEEPSEARCH_EXTERNAL_CACHE_DIR}",
    "tavily_api_key": "${TAVILY_API_KEY}"
  },
  "quality_loop": {
    "enabled": true
  },
  "deterministic_routing": {
    "enabled": true,
    "classifier": "llm",
    "fail_on_classifier_error": false,
    "hard_gate_missing_deterministic_tools": false,
    "llm_model_name": "${LOW_COST_MODEL}",
    "llm_temperature": 0.0,
    "computable_keywords": [],
    "computable_operators": [],
    "computable_policy": {
      "min_strong_hits": 1,
      "min_weak_hits": 1,
      "require_weak_cue": true
    }
  },
  "mcp_client": null,
  "llm": {
    "type": "openai_chat",
    "model_name": "${OPENAI_CHAT_MODEL}",
    "low_cost_model_name": "${LOW_COST_MODEL}",
    "openai_api_key": "${OPENAI_API_KEY}",
    "openai_base_url": "${OPENAI_BASE_URL}"
  },
  "telemetry_enabled": true
}
