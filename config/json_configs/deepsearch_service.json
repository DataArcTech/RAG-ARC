{
  "type": "deepsearch_service",
  "planner": {
    "mode": "react",
    "max_steps": 8,
    "enable_sub_question": true,
    "persist_plan": true,
    "plan_output_dir": "${DEEPSEARCH_PLAN_OUTPUT_DIR}",
    "web_step_policy": "realtime_required",
    "honor_planner_tool_selection": true,
    "graph_channel_tool": "graph_adapter.query",
    "text_channel_tool": "search",
    "web_channel_tool": "web.search",
    "tool_catalog_allowlist": [
      "search",
      "knowledge_base.explore",
      "graph.ops",
      "think",
      "web.search",
      "code.python"
    ],
    "tool_catalog_max_items": 6,
    "include_llm_tools_in_catalog": true,
    "graph_adapter_name": "${DEEPSEARCH_DEFAULT_ADAPTER}",
    "tool_arg_templates": {}
  },
  "graph_adapter": {
    "type": "graph_adapter",
    "adapter_name": "hipporag",
    "parameters": {
      "default_top_k": 5,
      "summary_max_chunks": 3,
      "summary_char_limit": 320,
      "semantic_score_threshold": 0.05,
      "retriever_config": {
        "type": "pruned_hipporag_neo4j_retrieval",
        "graph_config": {
          "type": "pruned_hipporag_neo4j",
          "url": "${NEO4J_URL}",
          "username": "${NEO4J_USERNAME}",
          "password": "${NEO4J_PASSWORD}",
          "database": "${NEO4J_DATABASE}",
          "storage_path": "${GRAPH_STORAGE_PATH}",
          "index_name": "${GRAPH_INDEX_NAME}",
          "embedding": {
            "type": "openai_embedding",
            "model_name": "${OPENAI_EMBEDDING_MODEL}",
            "embedding_dimensions": "${EMBEDDING_DIMENSIONS}",
            "openai_api_key": "${EMBEDDING_API_KEY}",
            "openai_base_url": "${EMBEDDING_API_BASE_URL}"
          },
          "add_synonymy_edges": true,
          "synonymy_edge_topk": 100,
          "synonymy_edge_sim_threshold": 0.8,
          "use_float16_embeddings": true,
          "normalize_chunk_embeddings": true
        },
        "llm_config": {
          "type": "openai_chat",
          "model_name": "${OPENAI_CHAT_MODEL}",
          "low_cost_model_name": "${LOW_COST_MODEL}",
          "temperature": 0.0,
          "openai_api_key": "${CHAT_API_KEY}",
          "openai_base_url": "${CHAT_API_BASE_URL}"
        },
        "fact_retrieval_top_k": 10,
        "max_facts_after_reranking": 5,
        "enable_llm_reranking": true,
        "damping_factor": 0.3,
        "ppr_backend": "push",
        "ppr_directed_mode": "off",
        "ppr_push_threshold_mode": "residual_over_degree",
        "ppr_push_target_degree_penalty_gamma": 0.5,
        "entity_reset_weight_aggregation": "sum_avg",
        "dense_file_closure_enabled": true,
        "ppr_push_epsilon": 1e-06
      }
    }
  },
  "graph_reasoning": {
    "strategy_name": "ppr_chain",
    "allow_semantic_channel": true,
    "chain_depth": 4,
    "enable_custom_hooks": false,
    "tool_context_max_evidences": 5,
    "tool_context_max_chars": 800,
    "compression": {
      "tool_context": {
        "mode": "truncate",
        "max_items": 5,
        "max_chars": 800,
        "excerpt_chars": 900,
        "retention": "tail"
      },
      "think": {
        "mode": "truncate",
        "max_items": 8,
        "max_chars": 1600,
        "excerpt_chars": 900,
        "retention": "head"
      }
    },
    "coverage_expected_min_chunks": 3,
    "trace_reflection_enabled": true,
    "trace_reflection_max": 24,
    "step_summary_max_chars": 2000,
    "parallel_branches": 1,
    "tool_timeout_seconds": 45.0,
    "think": {
      "tool_name": "think",
      "every_n_steps": 1,
      "min_coverage": 0.75,
      "always_run": true,
      "enable_tool_calls": true,
      "max_tool_calls": 4,
      "tool_call_concurrency": 2,
      "tool_catalog_max_items": 6,
      "tool_catalog_allowlist": [
        "search",
        "knowledge_base.explore",
        "graph.ops",
        "think",
        "web.search",
        "code.python"
      ],
      "include_llm_tools": true,
      "max_rounds_per_checkpoint": 2
    }
  },
  "multi_agent": {
    "enabled": true,
    "max_subagents": 4,
    "subagent_concurrency": 4,
    "enable_parallel_tool_probes": true,
    "probe_tool_names": [
      "search"
    ],
    "probe_concurrency": 4,
    "lead_tool_names": [
      "search"
    ],
    "lead_tool_concurrency": 2,
    "max_merge_evidences": 60,
    "worker_timeout_seconds": null,
    "worker_retry_attempts": 0,
    "fail_fast": false,
    "incremental_parallelism": true,
    "initial_worker_count": 1,
    "stop_min_evidence_count": 3,
    "stop_min_coverage_ratio": 0.85
  },
  "reporter": {
    "max_highlights": 6,
    "include_graph_viz": true,
    "enable_custom_summary": false,
    "parallel_thinking_runs": 1,
    "enable_llm_report": true,
    "include_appendices_in_answer": false,
    "report_temperature": 0.2,
    "report_max_evidence_chars": 900,
    "max_evidence_items": 10,
    "provenance_chunk_attach_max": 10,
    "report_max_graph_chain_items": 200,
    "report_max_seed_entities": 15,
    "enable_consistency_check": true,
    "consistency_temperature": 0.0,
    "consistency_max_retries": 2,
    "sectionwise_writer": true,
    "sectionwise_retain_k": 5,
    "citation_aliases": true,
    "outline_evidence_summary_chars": 240,
    "methodology_summary_chars": 1200,
    "keep_tool_results": 8,
    "enable_citation_agent": true,
    "parallel_sections": false,
    "max_parallel_sections": 4,
    "consistency_max_claims": 40,
    "synthesis_section_max_chars": 1200,
    "bench_answer": {
      "enabled": true,
      "allowed_evidence_kinds": [
        "primary"
      ],
      "heading_window_max_lines": 10,
      "default_policy": {
        "mode": "single_stage",
        "preference": "balanced",
        "max_evidence_items": 24,
        "max_evidence_chars": 12000,
        "snippet_chars": 900
      },
      "policies_by_question_type": {
        "Complex Reasoning": {
          "mode": "two_stage",
          "preference": "correctness",
          "max_evidence_items": 24,
          "max_evidence_chars": 12000,
          "snippet_chars": 900
        },
        "Contextual Summarize": {
          "mode": "single_stage",
          "preference": "coverage",
          "max_evidence_items": 24,
          "max_evidence_chars": 12000,
          "snippet_chars": 900
        },
        "Fact Retrieval": {
          "mode": "single_stage",
          "preference": "correctness",
          "max_evidence_items": 12,
          "max_evidence_chars": 6000,
          "snippet_chars": 450
        },
        "Creative Generation": {
          "mode": "single_stage",
          "preference": "balanced",
          "max_evidence_items": 24,
          "max_evidence_chars": 12000,
          "snippet_chars": 900
        }
      }
    }
  },
  "tool_manager": {
    "enable_builtin_tools": true,
    "search_retriever_config_path": "config/json_configs/rag_inference.json",
    "enabled_tools": {
      "graph.beam_search": {
        "params": {
          "beam_size": 3,
          "max_depth": 3,
          "temperature": 0.2,
          "seed_entity_top_k": 6
        }
      },
      "code.python": {
        "params": {
          "allowed_imports": [
            "json",
            "math",
            "decimal",
            "fractions",
            "statistics",
            "datetime",
            "numpy",
            "pandas",
            "scipy"
          ],
          "timeout_seconds": 6.0,
          "max_code_chars": 12000,
          "max_stdout_chars": 8000,
          "max_stderr_chars": 8000,
          "max_result_chars": 12000,
          "max_memory_mb": 1024,
          "emit_result_evidence": true,
          "disable_file_io": true
        }
      }
    },
    "audit_label": "${DEEPSEARCH_TOOL_AUDIT_LABEL}",
    "artifact_dir": "${DEEPSEARCH_TOOL_ARTIFACT_DIR}",
    "max_remote_evidences": 32,
    "max_remote_context_chars": 4096,
    "remote_tools": {}
  },
  "tool_budget": {
    "enabled": true,
    "max_calls_total": 60,
    "expose_to_llm": true
  },
  "quality_loop": {
    "enabled": true
  },
  "deterministic_routing": {
    "enabled": true,
    "classifier": "llm",
    "fail_on_classifier_error": false,
    "hard_gate_missing_deterministic_tools": false,
    "llm_model_name": "${LOW_COST_MODEL}",
    "llm_temperature": 0.0,
    "computable_keywords": [],
    "computable_operators": [],
    "computable_policy": {
      "min_strong_hits": 1,
      "min_weak_hits": 1,
      "require_weak_cue": true
    }
  },
  "mcp_client": null,
  "llm": {
    "type": "openai_chat",
    "model_name": "${OPENAI_CHAT_MODEL}",
    "low_cost_model_name": "${LOW_COST_MODEL}",
    "openai_api_key": "${CHAT_API_KEY}",
    "openai_base_url": "${CHAT_API_BASE_URL}"
  },
  "artifacts": {
    "enabled": true,
    "version": 2,
    "profiles": [
      "dev",
      "public"
    ],
    "state_snapshot_mode": "manifest",
    "refs": {
      "enabled": true
    },
    "dedupe": {
      "enabled": true,
      "evidence_pool_filename": "evidence_pool.json"
    },
    "public": {
      "include_final_report_in_json": false,
      "max_plan_steps": 12,
      "max_stage_history": 128,
      "max_errors": 64
    }
  },
  "telemetry_enabled": true
}