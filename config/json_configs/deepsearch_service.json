{
  "type": "deepsearch_service",
  "graph_adapter": {
    "type": "graph_adapter",
    "adapter_name": "hipporag",
    "parameters": {
      "default_top_k": 5,
      "summary_max_chunks": 3,
      "summary_char_limit": 320,
      "semantic_score_threshold": 0.05,
      "retriever_config": {
        "type": "pruned_hipporag_neo4j_retrieval",
        "preset": "balanced",
        "graph_config": {
          "type": "pruned_hipporag_neo4j",
          "url": "${NEO4J_URL}",
          "username": "${NEO4J_USERNAME}",
          "password": "${NEO4J_PASSWORD}",
          "database": "${NEO4J_DATABASE}",
          "storage_path": "${GRAPH_STORAGE_PATH}",
          "index_name": "${GRAPH_INDEX_NAME}",
          "embedding": {
            "type": "openai_embedding",
            "model_name": "${OPENAI_EMBEDDING_MODEL}",
            "embedding_dimensions": "${EMBEDDING_DIMENSIONS}",
            "openai_api_key": "${EMBEDDING_API_KEY}",
            "openai_base_url": "${EMBEDDING_API_BASE_URL}"
          },
          "add_synonymy_edges": true,
          "synonymy_edge_topk": 100,
          "synonymy_edge_sim_threshold": 0.8,
          "use_float16_embeddings": true,
          "normalize_chunk_embeddings": true
        },
        "llm_config": {
          "type": "openai_chat",
          "model_name": "${OPENAI_CHAT_MODEL}",
          "low_cost_model_name": "${LOW_COST_MODEL}",
          "temperature": 0.0,
          "openai_api_key": "${CHAT_API_KEY}",
          "openai_base_url": "${CHAT_API_BASE_URL}"
        },
        "fact_retrieval_top_k": 10,
        "max_facts_after_reranking": 5,
        "enable_llm_reranking": true,
        "damping_factor": 0.3,
        "ppr_backend": "push",
        "ppr_directed_mode": "off",
        "ppr_push_threshold_mode": "residual_over_degree",
        "ppr_push_target_degree_penalty_gamma": 0.5,
        "entity_reset_weight_aggregation": "sum_avg",
        "dense_file_closure_enabled": true,
        "ppr_push_epsilon": 1e-06
      }
    }
  },
  "graph_reasoning": {
    "strategy_name": "ppr_chain",
    "allow_semantic_channel": true,
    "chain_depth": 4,
    "enable_custom_hooks": false,
    "coverage_expected_min_chunks": 3,
    "trace_reflection_enabled": true,
    "trace_reflection_max": 24,
    "step_summary_max_chars": 2000,
    "parallel_branches": 1,
    "tool_timeout_seconds": 45.0,
    "think": {
      "tool_name": "think",
      "every_n_steps": 1,
      "min_coverage": 0.75,
      "always_run": true,
      "enable_tool_calls": true,
      "max_tool_calls": 4,
      "tool_call_concurrency": 2,
      "tool_catalog_max_items": 12,
      "tool_catalog_allowlist": [
        "explore",
        "code.python"
      ],
      "include_llm_tools": true,
      "recent_tool_runs_max": 3,
      "max_rounds_per_checkpoint": 8
    }
  },
  "reporter": {
    "max_highlights": 6,
    "include_graph_viz": true,
    "enable_custom_summary": false,
    "parallel_thinking_runs": 1,
    "enable_llm_report": true,
    "include_appendices_in_answer": false,
    "report_temperature": 0.2,
    "provenance_chunk_attach_max": 10,
    "report_max_graph_chain_items": 200,
    "report_max_seed_entities": 15,
    "sectionwise_writer": true,
    "sectionwise_retain_k": 5,
    "citation_aliases": true,
    "keep_tool_results": 8,
    "enable_citation_agent": true,
    "parallel_sections": false,
    "max_parallel_sections": 4,
    "synthesis_section_max_chars": 1200
  },
  "tool_manager": {
    "enable_builtin_tools": true,
    "search_retriever_config_path": "config/json_configs/rag_inference.json",
    "enabled_tools": {
      "code.python": {
        "params": {
          "allowed_imports": [
            "json",
            "math",
            "decimal",
            "fractions",
            "statistics",
            "datetime",
            "numpy",
            "pandas",
            "scipy"
          ],
          "timeout_seconds": 6.0,
          "max_code_chars": 12000,
          "max_stdout_chars": 8000,
          "max_stderr_chars": 8000,
          "max_result_chars": 12000,
          "max_memory_mb": 1024,
          "emit_result_evidence": true,
          "disable_file_io": true
        }
      },
      "web.search": {
        "params": {
          "aggregate_enabled": true,
          "aggregate_group_by": "domain",
          "aggregate_max_groups": 3,
          "aggregate_max_results_per_group": 2
        }
      }
    },
    "audit_label": "${DEEPSEARCH_TOOL_AUDIT_LABEL}",
    "artifact_dir": "${DEEPSEARCH_TOOL_ARTIFACT_DIR}",
    "max_remote_evidences": 32,
    "max_remote_context_chars": 4096,
    "remote_tools": {}
  },
  "tool_budget": {
    "enabled": true,
    "max_calls_total": 60,
    "expose_to_llm": true
  },
  "plan_cache": {
    "enabled": true,
    "max_entries": 256,
    "ttl_seconds": 1800
  },
  "initial_think_template": {
    "enabled": true,
    "model_name": "${LOW_COST_MODEL}",
    "temperature": 0.0,
    "max_tokens": 800,
    "json_attempts": 2
  },
  "deterministic_routing": {
    "enabled": true,
    "classifier": "llm",
    "fail_on_classifier_error": false,
    "hard_gate_missing_deterministic_tools": false,
    "llm_model_name": "${LOW_COST_MODEL}",
    "llm_temperature": 0.0,
    "computable_keywords": [],
    "computable_operators": [],
    "computable_policy": {
      "min_strong_hits": 1,
      "min_weak_hits": 1,
      "require_weak_cue": true
    }
  },
  "mcp_client": null,
  "llm": {
    "type": "openai_chat",
    "model_name": "${OPENAI_CHAT_MODEL}",
    "low_cost_model_name": "${LOW_COST_MODEL}",
    "openai_api_key": "${CHAT_API_KEY}",
    "openai_base_url": "${CHAT_API_BASE_URL}"
  },
  "artifacts": {
    "enabled": true,
    "version": 2,
    "profiles": [
      "dev",
      "public"
    ],
    "state_snapshot_mode": "manifest",
    "refs": {
      "enabled": true
    },
    "dedupe": {
      "enabled": true,
      "evidence_pool_filename": "evidence_pool.json"
    },
    "public": {
      "include_final_report_in_json": false,
      "max_plan_steps": 12,
      "max_stage_history": 128,
      "max_errors": 64
    }
  },
  "telemetry_enabled": true
}
