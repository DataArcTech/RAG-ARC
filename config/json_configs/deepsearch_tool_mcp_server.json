{
  "type": "deepsearch_tool_mcp_server",
  "instructions": "DeepSearch tool MCP server exposing all registered tools.",
  "llm_config": {
    "type": "openai_chat",
    "model_name": "${OPENAI_CHAT_MODEL}",
    "openai_api_key": "${OPENAI_API_KEY}",
    "openai_base_url": "${OPENAI_BASE_URL}"
  },
  "graph_adapter": {
    "type": "graph_adapter",
    "adapter_name": "${DEEPSEARCH_DEFAULT_ADAPTER}",
    "parameters": {
      "retriever_config": {
        "type": "pruned_hipporag_neo4j_retrieval",
        "graph_config": {
          "type": "pruned_hipporag_neo4j",
          "url": "${NEO4J_URL}",
          "username": "${NEO4J_USERNAME}",
          "password": "${NEO4J_PASSWORD}",
          "database": "${NEO4J_DATABASE}",
          "storage_path": "./data/graph_index_neo4j",
          "index_name": "index",
          "embedding": {
            "type": "openai_embedding",
            "model_name": "${OPENAI_EMBEDDING_MODEL}",
            "openai_api_key": "${OPENAI_API_KEY}",
            "openai_base_url": "${OPENAI_BASE_URL}"
          },
          "add_synonymy_edges": true,
          "synonymy_edge_topk": 100,
          "synonymy_edge_sim_threshold": 0.8,
          "use_float16_embeddings": true,
          "normalize_chunk_embeddings": true
        },
        "llm_config": {
          "type": "openai_chat",
          "model_name": "${OPENAI_CHAT_MODEL}",
          "temperature": 0.0,
          "openai_api_key": "${OPENAI_API_KEY}",
          "openai_base_url": "${OPENAI_BASE_URL}"
        },
        "fact_retrieval_top_k": 10,
        "max_facts_after_reranking": 5,
        "enable_llm_reranking": true,
        "damping_factor": 0.5,
        "ppr_backend": "push"
      }
    }
  },
  "tool_manager": {
    "enable_builtin_tools": true,
    "enabled_tools": {},
    "audit_label": "${DEEPSEARCH_TOOL_MCP_AUDIT_LABEL}"
  },
  "scope": null
}
